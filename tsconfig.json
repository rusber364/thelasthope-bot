{
  // Node запускает .ts-файлы напрямую (просто вырезает типы),
  // а tsc используется только для проверки типов: `pnpm typecheck`.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "esnext.temporal"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}

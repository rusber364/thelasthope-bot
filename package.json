{
  "name": "thelasthope-bot",
  "version": "0.2.0",
  "private": true,
  "description": "Discord-бот для гильдии The Last Hope",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.ts",
    "dev:admin": "pnpm --filter admin-ui dev",
    "start": "node --env-file=.env src/index.ts",
    "build": "pnpm --filter admin-ui build",
    "deploy": "node --env-file=.env src/deploy-commands.ts",
    "brand": "node --env-file=.env src/scripts/brand.ts",
    "backup": "node src/scripts/backup.ts",
    "sveta:import": "node --env-file=.env src/scripts/sveta-import.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc",
    "check:admin": "pnpm --filter admin-ui check"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "discord.js": "^14.27.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "backlog.md": "^1.53.0",
    "typescript": "^7.0.2"
  }
}

{
  "name": "thelasthope-bot",
  "version": "0.2.0",
  "private": true,
  "description": "Discord-бот для гильдии The Last Hope",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env src/index.ts",
    "deploy": "node --env-file=.env src/deploy-commands.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}

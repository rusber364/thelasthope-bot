# Скопируй этот файл в .env и заполни значения.
# .env в git не попадает — токен и секреты никому не показывай.
#
# Как скопировать ID: Discord → Настройки → Расширенные → «Режим разработчика»,
# потом ПКМ по каналу / роли / серверу → «Копировать ID».

# Developer Portal → твоё приложение → Bot → Reset Token
# (имя DISCORD_TOKEN не используем: оно для Discord MCP — отдельного бота для Claude)
DISCORD_TOKEN_GUILD=

# Developer Portal → General Information → Application ID
CLIENT_ID=

# ID сервера. Если указан — команды регистрируются только на нём и появляются сразу,
# и админка управляет именно им. Если пусто — команды глобально (появление до часа).
GUILD_ID=

# --- Админка (http://localhost:3000) ---
# Developer Portal → OAuth2 → Client Secret (Reset Secret).
# Там же в Redirects добавь: http://localhost:3000/auth/callback
DISCORD_CLIENT_SECRET=
# Любая длинная случайная строка — ею подписываются сессии. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Необязательно: порт и адрес админки (на VPS — https://твой-домен, тогда Redirect тоже с ним)
# ADMIN_PORT=3000
# ADMIN_URL=http://localhost:3000

# --- Света: ИИ-персонаж в выбранных каналах (необязательно) ---
# Отдельное приложение «Света» в Developer Portal → Bot → Reset Token; там же включи Message Content Intent.
SVETA_TOKEN=
# Ключ Google Gemini: aistudio.google.com → Get API key (бесплатный тариф).
GEMINI_API_KEY=
# Ключ OpenRouter — для моделей с «/» в имени (например, бесплатная minimax/minimax-m3.1-flash:free):
# openrouter.ai/keys → Create Key. Какие модели основная и запасная — в админке «Света».
OPENROUTER_API_KEY=

# --- Каналы и роли (необязательно) ---
# Удобнее выбрать их в админке. Значения ниже используются, только пока в админке ничего не сохранено.
WELCOME_CHANNEL_ID=
RULES_CHANNEL_ID=
GUEST_ROLE_ID=
AUTOROLE_ID=
RAID_CHANNEL_1_ID=
RAID_CHANNEL_2_ID=
MOD_LOG_CHANNEL_ID=

# Скопируй этот файл в .env и заполни значения.
# .env в git не попадает — токен никому не показывай.
#
# Как скопировать ID: Discord → Настройки → Расширенные → «Режим разработчика»,
# потом ПКМ по каналу / роли / серверу → «Копировать ID».

# Developer Portal → твоё приложение → Bot → Reset Token
DISCORD_TOKEN=

# Developer Portal → General Information → Application ID
CLIENT_ID=

# ID сервера. Если указан — команды регистрируются только на нём и появляются сразу.
# Если пусто — глобально (появление может занять до часа).
GUILD_ID=

# --- Приветствие ---
# Канал, куда бот пишет приветствие новичкам
WELCOME_CHANNEL_ID=
# Канал #правила (ссылка в тексте и кнопка «Правила»)
RULES_CHANNEL_ID=
# Канал #авторизация (ссылка в тексте)
AUTH_CHANNEL_ID=
# Роль «Гость», которую новичок может взять кнопкой в приветствии
GUEST_ROLE_ID=
# Роль, которую бот выдаёт каждому новичку автоматически (без кнопки). Можно оставить пустым.
AUTOROLE_ID=

# --- Рейды ---
# Два канала, где бот сам открывает реги в 00:00 чт, пт и пн (расписание — в src/settings.ts)
RAID_CHANNEL_1_ID=
RAID_CHANNEL_2_ID=

# --- Модерация ---
# Канал для журнала модерации (кик, бан, мут, очистка, удалённый мат)
MOD_LOG_CHANNEL_ID=
